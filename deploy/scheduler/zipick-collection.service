[Unit]
Description=ZIPICK daily notice and AI collection
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# 지표 디렉터리(/var/lib/zipick/metrics)와 잠금 파일을 ubuntu 소유로 유지한다.
# root 로 돌면 잠금 파일이 root 전용으로 생겨 ubuntu 로 실행하는 수집이 실패한다.
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/zipick/collector.env
ExecStart=/bin/bash ${ZIPICK_DEPLOY_DIR}/monitoring/run-daily-collection.sh
# 멈춘 실행이 끝나지 않으면 다음 날 예약도 시작되지 않으므로 상한을 둔다.
TimeoutStartSec=6h
# 75: 다른 수집이 이미 실행 중이라 이번 실행을 건너뜀
SuccessExitStatus=75
