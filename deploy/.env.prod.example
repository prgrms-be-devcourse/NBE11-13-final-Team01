# 서버의 ~/zipick/.env 로 복사해 값을 채운다. 이 파일(값이 채워진 것)은 절대 git 에 올리지 않는다.
#   chmod 600 ~/zipick/.env

# --- DB (처음 뜰 때 이 계정으로 만들어진다. 나중에 바꾸려면 DB 볼륨을 지워야 함) ---
DB_USERNAME=zipick
DB_PASSWORD=            # openssl rand -base64 24

# --- 인증 ---
JWT_SECRET=             # openssl rand -base64 32

# --- 알림센터 (메인 ↔ 알림센터 공유 키) ---
NOTIFICATION_INTERNAL_KEY=   # openssl rand -hex 24

# --- RabbitMQ (알림 요청 큐, 컨테이너 안에서만 접근) ---
RABBITMQ_USER=zipick
RABBITMQ_PASSWORD=           # openssl rand -hex 12

# --- 접속 주소 ---
# 도메인 없이 IP 로: SITE_ADDRESS=:80, APP_ORIGIN=http://<탄력적 IP>, COOKIE_SECURE=false
# 도메인 + https:   SITE_ADDRESS=zipick.example.com, APP_ORIGIN=https://zipick.example.com, COOKIE_SECURE=true
SITE_ADDRESS=:80
APP_ORIGIN=http://0.0.0.0
COOKIE_SECURE=false

# --- 외부 API ---
MYHOME_API_KEY=         # 공공데이터포털(마이홈) 서비스 키
KAKAO_REST_API_KEY=     # 카카오 REST API 키 (주소 좌표·주변 인프라)
VITE_KAKAO_MAP_KEY=     # 카카오 JavaScript 키 (프론트 빌드 때 사용, 콘솔에 배포 주소 도메인 등록 필요)

# --- 이메일 알림 (알림센터) ---
# none: 이메일 안 보냄(슬랙만) / smtp: 아래 MAIL_* 사용 / ses: AWS SES (발신 주소를 SES 에서 인증해야 함)
NOTIFICATION_EMAIL_PROVIDER=none
NOTIFICATION_EMAIL_FROM=      # 예: no-reply@zipick.example.com (SES 인증 주소 또는 SMTP 계정)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=            # SES 전용 IAM 사용자 키 (EC2 에 IAM 역할을 붙였으면 비워 둠)
AWS_SECRET_ACCESS_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
