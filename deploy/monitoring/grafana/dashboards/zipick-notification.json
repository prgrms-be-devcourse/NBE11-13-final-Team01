  "panels": [
    {
      "id": 1,
      "title": "알림센터 접속",
      "description": "알림센터 GET /health의 HTTP 응답입니다. DB·큐 연결과 실제 발송 성공을 보장하지 않습니다.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "알림센터 접속",
          "noValue": "측정 정보 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "연결 실패",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "정상",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "측정 정보 없음",
                  "color": "gray",
                  "index": 99
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical",
        "text": {
          "titleSize": 20,
          "valueSize": 32
        },
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "min(probe_success{job=\"service-probe\",service=\"notification\",environment!~\"synthetic_test|real_process_failure_test\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
