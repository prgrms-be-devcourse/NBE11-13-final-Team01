          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "연결 실패",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "정상",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
