    {
      "id": 5,
      "title": "API 응답 시간",
      "description": "p95는 정해진 시간 구간에 기반한 추정치이며 요청이 적을 때 불안정합니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"backend\",uri!~\"/actuator.*\",environment!~\"synthetic_test|real_process_failure_test\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"backend\",uri!~\"/actuator.*\",environment!~\"synthetic_test|real_process_failure_test\"}[5m])), 0.000001)",
          "legendFormat": "평균",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backend\",uri!~\"/actuator.*\",environment!~\"synthetic_test|real_process_failure_test\"}[5m])))",
          "legendFormat": "p95 추정",
          "refId": "B"
        }
      ]
    },
