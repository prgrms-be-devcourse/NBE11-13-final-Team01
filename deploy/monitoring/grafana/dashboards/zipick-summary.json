{
  "uid": "zipick-overview",
  "title": "ZIPICK · 서버·컨테이너",
  "description": "서버와 컨테이너의 자원 사용을 확인합니다.",
  "schemaVersion": 40,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "서버·컨테이너",
      "type": "link",
      "url": "/grafana/d/zipick-overview",
      "targetBlank": false
    },
    {
      "title": "메인 서비스",
      "type": "link",
      "url": "/grafana/d/zipick-details",
      "targetBlank": false
    },
    {
      "title": "공고 수집기",
      "type": "link",
      "url": "/grafana/d/zipick-collector",
      "targetBlank": false
    },
    {
      "title": "알림 시스템",
      "type": "link",
      "url": "/grafana/d/zipick-notification",
      "targetBlank": false
    },
    {
      "title": "부하테스트",
      "type": "link",
      "url": "/grafana/d/zipick-load-test",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "서버 CPU 사용률",
      "description": "서버별 CPU 사용률의 시간 변화입니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (server_name) (rate(node_cpu_seconds_total{mode=\"idle\",server_name!=\"\",environment!~\"synthetic_test|real_process_failure_test\"}[5m])))",
          "legendFormat": "{{server_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "서버 메모리 사용률",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{server_name!=\"\",environment!~\"synthetic_test|real_process_failure_test\"} / node_memory_MemTotal_bytes{server_name!=\"\",environment!~\"synthetic_test|real_process_failure_test\"})",
          "legendFormat": "{{server_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "컨테이너 메모리",
      "description": "Docker에서 확인된 컨테이너별 사용량입니다. 지표가 없으면 0이 아닙니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\",environment!~\"synthetic_test|real_process_failure_test\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "컨테이너 CPU",
      "description": "코어 단위 사용량입니다. 1은 CPU 코어 한 개를 뜻합니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\",environment!~\"synthetic_test|real_process_failure_test\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "서버 디스크 여유",
      "description": "서버 루트 파일시스템의 사용 가능한 용량입니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{server_name!=\"\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\",environment!~\"synthetic_test|real_process_failure_test\"}",
          "legendFormat": "{{server_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "서버 스왑 사용량",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "zipick-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "node_memory_SwapTotal_bytes{server_name!=\"\",environment!~\"synthetic_test|real_process_failure_test\"} - node_memory_SwapFree_bytes{server_name!=\"\",environment!~\"synthetic_test|real_process_failure_test\"}",
          "legendFormat": "{{server_name}}",
          "refId": "A"
        }
      ]
    }
  ]
}
